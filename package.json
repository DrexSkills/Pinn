{
  "name": "pinn",
  "version": "1.0.13",
  "description": "Pinn — AI that stays out of sight",
  "main": "main.js",
  "author": "Pinn",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build:win": "npx electron-builder --win --x64",
    "build:mac": "npx electron-builder --mac"
  },
  "build": {
    "appId": "com.microsoft.audiodg",
    "productName": "AudioDG",
    "copyright": "Copyright © Microsoft Corporation",
    "icon": "assets/icon",
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        { "target": "zip", "arch": ["universal"] }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "x64ArchFiles": "*"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "allowElevation": true
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!dist",
      "!releases",
      "!*.md"
    ]
  },
  "keywords": [],
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5"
  }
}
